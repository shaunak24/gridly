#!/bin/sh
# Enforce commit message format: vx.y.z: <description>

commit_msg_file="$1"
msg=$(head -n 1 "$commit_msg_file")

# Merge commits use Git's default message.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

pattern='^v[0-9]+\.[0-9]+\.[0-9]+: .+$'

if ! printf '%s' "$msg" | grep -Eq "$pattern"; then
  echo "commit-msg hook: invalid commit message format." >&2
  echo "Expected: vx.y.z: <description>" >&2
  echo "Example:  v4.3.1: Fix Play draft submit and document closed testing roadmap." >&2
  echo "" >&2
  echo "Your message: $msg" >&2
  exit 1
fi
