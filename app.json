{
  "expo": {
    "name": "Gridly",
    "slug": "gridly",
    "scheme": "gridly",
    "version": "4.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gridlygames.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B2E"
      },
      "package": "com.gridlygames.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "gridly",
              "host": "games",
              "pathPrefix": "/"
            },
            {
              "scheme": "gridly",
              "host": "game"
            },
            {
              "scheme": "gridly"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F97316"
        }
      ],
      "expo-audio",
      "./plugins/withDisableNotificationsBootActions",
      "./plugins/withAndroidGameCategory",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bb4bcf9-2add-4f58-b3bf-df1a18f33351"
    },
    "extra": {
      "eas": {
        "projectId": "2bb4bcf9-2add-4f58-b3bf-df1a18f33351"
      }
    }
  }
}
